---
import Base from "../../layouts/Base.astro";
import { db } from "../../lib/supabase";
import { siteUrl } from "../../lib/env";
import { nbBlogPath, nbPostPath, formatDate } from "../../lib/urls";
import { LIMITS } from "../../config";

export const prerender = false;

const page = Math.max(1, Number(Astro.url.searchParams.get("page") ?? "1") || 1);
const from = (page - 1) * LIMITS.LIST_PAGE_SIZE;
const to = from + LIMITS.LIST_PAGE_SIZE - 1;

const client = db(Astro.locals);

const { data: blogs } = await client
  .from("nb_blogs")
  .select("blog_id, nickname")
  .eq("status", "verified")
  .order("created_at", { ascending: true });

const verifiedIds = (blogs ?? []).map(blog => blog.blog_id);
const nameById = new Map((blogs ?? []).map(blog => [blog.blog_id, blog.nickname ?? blog.blog_id]));

const { data: posts, count } = verifiedIds.length
  ? await client
      .from("nb_posts")
      .select("blog_id, log_no, title, excerpt, published_at", { count: "exact" })
      .in("blog_id", verifiedIds)
      .eq("status", "live")
      .order("published_at", { ascending: false, nullsFirst: false })
      .range(from, to)
  : { data: [], count: 0 };

const total = count ?? 0;
const lastPage = Math.max(1, Math.ceil(total / LIMITS.LIST_PAGE_SIZE));
if (page > lastPage && total > 0) return Astro.rewrite("/404");

const base = siteUrl(Astro.locals);

Astro.response.headers.set(
  "cache-control",
  "public, max-age=0, s-maxage=600, stale-while-revalidate=86400",
);
---

<Base
  title="색인 목록"
  description="등록된 네이버 블로그 글의 요약과 원문 링크 모음입니다."
  canonicalPath={page === 1 ? "/nb" : `/nb?page=${page}`}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "색인 목록",
    url: `${base}/nb`,
    inLanguage: "ko",
  }}
>
  <h1 class="m-0 text-2xl font-bold">색인 목록</h1>
  <p class="mt-2 text-muted">등록된 블로그 {verifiedIds.length}곳 · 글 {total}건</p>

  {
    blogs && blogs.length > 0 && (
      <ul class="mt-6 flex list-none flex-wrap gap-2 p-0 text-sm">
        {blogs.map(blog => (
          <li>
            <a
              href={nbBlogPath(blog.blog_id)}
              class="inline-block rounded-full border border-line px-3 py-1 no-underline hover:border-accent"
            >
              {blog.nickname ?? blog.blog_id}
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {
    posts && posts.length > 0 ? (
      <ul class="mt-8 list-none space-y-6 p-0">
        {posts.map(post => (
          <li class="border-b border-line pb-6 last:border-0">
            <a href={nbPostPath(post.blog_id, post.log_no)} class="no-underline">
              <h2 class="m-0 text-lg font-semibold hover:underline">{post.title}</h2>
            </a>
            <p class="m-0 mt-1 text-sm text-muted">
              {nameById.get(post.blog_id)}
              {post.published_at && ` · ${formatDate(post.published_at)}`}
            </p>
            {post.excerpt && <p class="m-0 mt-2 line-clamp-2 text-sm text-muted">{post.excerpt}</p>}
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-8 text-muted">
        아직 등록된 글이 없습니다.{" "}
        <a href="/" class="underline">
          첫 글을 등록
        </a>
        해 보세요.
      </p>
    )
  }

  {
    lastPage > 1 && (
      <nav aria-label="페이지" class="mt-8 flex justify-between text-sm">
        {page > 1 ? (
          <a href={page === 2 ? "/nb" : `/nb?page=${page - 1}`} class="underline">
            ← 이전
          </a>
        ) : (
          <span />
        )}
        <span class="text-muted">
          {page} / {lastPage}
        </span>
        {page < lastPage ? (
          <a href={`/nb?page=${page + 1}`} class="underline">
            다음 →
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }
</Base>
