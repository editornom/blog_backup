---
import Base from "../../../layouts/Base.astro";
import { BLOGS, findBlog, SITE } from "../../../config";
import { postsOf } from "../../../lib/store";
import { nbBlogPath, nbPostPath, formatDate } from "../../../lib/urls";

export function getStaticPaths() {
  return BLOGS.map(blog => ({ params: { blogId: blog.blogId } }));
}

const { blogId } = Astro.params;
const blog = findBlog(blogId!)!;
const posts = postsOf(blog.blogId);
const path = nbBlogPath(blog.blogId);
const naverUrl = `https://blog.naver.com/${blog.blogId}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${blog.name} 글 목록`,
  url: `${SITE.url}${path}`,
  inLanguage: "ko",
  about: { "@type": "Blog", name: blog.name, url: naverUrl },
};
---

<Base
  title={`${blog.name} 글 목록`}
  description={`${blog.name} — ${blog.tagline}. 최근 글 ${posts.length}건의 요약과 원문 링크입니다.`}
  canonicalPath={path}
  jsonLd={jsonLd}
>
  <nav aria-label="위치" class="mb-6 text-sm text-muted">
    <a href="/" class="no-underline hover:underline">{SITE.name}</a>
  </nav>

  <h1 class="m-0 text-2xl font-bold">{blog.name}</h1>
  <p class="mt-2 text-muted">{blog.tagline}</p>
  <p class="mt-3 leading-relaxed">{blog.description}</p>
  <p class="mt-3 text-sm">
    <a href={naverUrl} class="underline">네이버 블로그 바로가기</a>
  </p>

  {
    posts.length > 0 ? (
      <ul class="mt-8 list-none space-y-6 p-0">
        {posts.map(post => (
          <li class="border-b border-line pb-6 last:border-0">
            <a href={nbPostPath(blog.blogId, post.logNo)} class="no-underline">
              <h2 class="m-0 text-lg font-semibold hover:underline">{post.title}</h2>
            </a>
            {post.publishedAt && (
              <p class="m-0 mt-1 text-sm text-muted">{formatDate(post.publishedAt)}</p>
            )}
            {post.excerpt && <p class="m-0 mt-2 line-clamp-3 text-sm text-muted">{post.excerpt}</p>}
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-8 text-muted">
        아직 수집된 글이 없습니다.{" "}
        <a href={naverUrl} class="underline">
          네이버 블로그
        </a>
        에서 바로 보실 수 있습니다.
      </p>
    )
  }
</Base>
