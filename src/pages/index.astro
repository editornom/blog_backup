---
import Base from "../layouts/Base.astro";
import { SITE, BLOGS } from "../config";
import { allPosts, postsOf } from "../lib/store";
import { nbBlogPath, nbPostPath, formatDate } from "../lib/urls";
import { LIMITS } from "../config";

const recent = allPosts()
  .filter(post => post.status === "live")
  .slice(0, LIMITS.HOME_RECENT);
const nameById = new Map(BLOGS.map(blog => [blog.blogId, blog.name]));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: "ko",
};
---

<Base title={SITE.name} description={SITE.description} canonicalPath="/" jsonLd={jsonLd}>
  <h1 class="m-0 text-3xl font-bold tracking-tight">{SITE.tagline}</h1>
  <p class="mt-4 text-lg text-muted">
    하이온넷이 운영하는 네이버 블로그 {BLOGS.length}곳을 한곳에 모았습니다. 서비스별로 어떤 블로그를
    보면 되는지 아래에서 고르세요.
  </p>

  <section class="mt-10">
    <h2 class="m-0 text-xl font-semibold">블로그</h2>
    <ul class="mt-5 list-none space-y-6 p-0">
      {
        BLOGS.map(blog => (
          <li class="border-b border-line pb-6 last:border-0">
            <h3 class="m-0 text-lg font-semibold">
              <a href={`https://blog.naver.com/${blog.blogId}`}>{blog.name}</a>
            </h3>
            <p class="m-0 mt-1 text-sm text-muted">{blog.tagline}</p>
            <p class="mt-3 text-base leading-relaxed">{blog.description}</p>
            <p class="mt-3 text-sm">
              <a href={`https://blog.naver.com/${blog.blogId}`} class="underline">
                네이버 블로그 바로가기
              </a>
              {postsOf(blog.blogId).length > 0 && (
                <>
                  <span aria-hidden="true"> · </span>
                  <a href={nbBlogPath(blog.blogId)} class="underline">
                    최근 글 {postsOf(blog.blogId).length}건
                  </a>
                </>
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    recent.length > 0 && (
      <section class="mt-12">
        <h2 class="m-0 text-xl font-semibold">최근 글</h2>
        <ul class="mt-5 list-none space-y-5 p-0">
          {recent.map(post => (
            <li>
              <a href={nbPostPath(post.blogId, post.logNo)} class="no-underline">
                <span class="font-semibold hover:underline">{post.title}</span>
              </a>
              <p class="m-0 mt-1 text-sm text-muted">
                {nameById.get(post.blogId)}
                {post.publishedAt && ` · ${formatDate(post.publishedAt)}`}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
