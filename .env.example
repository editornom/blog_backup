# 배포 도메인 (마지막 슬래시 없이)
PUBLIC_SITE_URL=https://editornom.com

# Supabase — 서버 전용 키입니다. 클라이언트에 절대 노출하지 마세요.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# IndexNow 키 (32자 이상 영숫자). https://<도메인>/<키>.txt 로 자동 노출됩니다.
INDEXNOW_KEY=

# 관리자 엔드포인트(/api/sync, /api/blogs) 인증 토큰
ADMIN_TOKEN=
